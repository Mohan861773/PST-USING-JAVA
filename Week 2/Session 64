4.Richest customer health
class Solution {
    public int maximumWealth(int[][] accounts) {
        int maxWealth = 0;

        for (int i = 0; i < accounts.length; i++) {
            int wealth = 0;

            for (int j = 0; j < accounts[i].length; j++) {
                wealth += accounts[i][j];
            }

            maxWealth = Math.max(maxWealth, wealth);
        }

        return maxWealth;
    }
}
Input:
accounts = [[1,2,3],
            [3,2,1]]

Customer 1 = 1 + 2 + 3 = 6
Customer 2 = 3 + 2 + 1 = 6

Output:
6
