import java.util.*;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        LinkedHashSet<String> items =
                new LinkedHashSet<>();

        for (int i = 0; i < n; i++) {
            items.add(sc.next());
        }

        System.out.println(items);

        sc.close();
    }
}
Sample Input
6
Apple Milk Bread Apple Milk Rice


Sample Output
[Apple, Milk, Bread, Rice]
