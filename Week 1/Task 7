import java.util.Arrays;

class Solution {
    public int[] sortedSquares(int[] nums) {

        int n = nums.length;
        int[] result = new int[n];

        for (int i = 0; i < n; i++) {
            result[i] = nums[i] * nums[i];
        }

        Arrays.sort(result);

        return result;
    }
}
Input:
nums = [-4,-1,0,3,10]


Output:
[0,1,9,16,100]
