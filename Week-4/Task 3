import java.util.*;

public class Solution {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int alice = 0;
        int bob = 0;

        for (int i = 0; i < 3; i++) {

            int a = sc.nextInt();
            int b = sc.nextInt();

            if (a > b) {
                alice++;
            } 
            else if (a < b) {
                bob++;
            }
        }

        System.out.println(alice + " " + bob);

        sc.close();
    }
}
Input:
5 6 7
3 6 10


Output:
1 1
